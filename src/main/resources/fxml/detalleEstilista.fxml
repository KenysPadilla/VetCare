<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="460" prefHeight="420" styleClass="detail-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.DetalleEstilistaController">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox styleClass="detail-header" spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="detail-header-brand">
                <HBox alignment="CENTER" styleClass="detail-header-logo-box">
                    <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="detail-header-logo">
                        <image><Image url="@../images/logo-white.png" /></image>
                    </ImageView>
                </HBox>
                <VBox spacing="3">
                    <Label text="Perfil de Estilista" styleClass="detail-header-title" />
                    <Label fx:id="lblHeaderNombre" styleClass="detail-header-subtitle" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="detail-content" spacing="14" VBox.vgrow="ALWAYS">

                <Label text="INFORMACIÓN PERSONAL" styleClass="detail-section-title" />
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="140" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="Nombre completo:" styleClass="detail-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label fx:id="lblNombreCompleto" styleClass="detail-field-value-bold" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="Cédula:"           styleClass="detail-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label fx:id="lblCedula"        styleClass="detail-field-value" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                    <Label text="Especialidad:"     styleClass="detail-field-label" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                    <Label fx:id="lblEspecialidad" style="-fx-font-weight: bold; -fx-text-fill: #e67e22;"
                           styleClass="detail-field-value" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                </GridPane>

                <Label text="CONTACTO" styleClass="detail-section-title" />
                <GridPane hgap="12" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140" prefWidth="140" />
                        <ColumnConstraints hgrow="ALWAYS" />
                    </columnConstraints>
                    <Label text="Teléfono:" styleClass="detail-field-label" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                    <Label fx:id="lblTelefono" styleClass="detail-field-value" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                    <Label text="Email:"     styleClass="detail-field-label" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                    <Label fx:id="lblEmail"  styleClass="detail-field-value" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                </GridPane>

        </VBox>

        <HBox alignment="CENTER_RIGHT" styleClass="detail-footer">
            <Button text="Cerrar" onAction="#handleCerrar"
                    prefHeight="28" minHeight="28" maxHeight="28" prefWidth="90"
                    styleClass="btn-cerrar" />
        </HBox>

    </VBox>
</AnchorPane>
