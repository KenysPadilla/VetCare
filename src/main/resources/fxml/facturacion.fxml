<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane styleClass="module-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FacturacionController">

    <VBox spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="module-page-header">
            <Label style="-fx-font-size: 13px;" styleClass="module-page-subtitle" text="Facturación y cobros a propietarios" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleNueva" prefHeight="40" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary btn-add" text="+  Nueva Factura" />
        </HBox>

        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Total Facturas" />
                <Label fx:id="lblStatTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b87a0;" styleClass="mini-stat-value mini-stat-teal" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Pendientes" />
                <Label fx:id="lblStatPendientes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" styleClass="mini-stat-value mini-stat-orange" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Pagadas" />
                <Label fx:id="lblStatPagadas" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" styleClass="mini-stat-value mini-stat-green" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Ingresos Pagados" />
                <Label fx:id="lblStatIngresos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;" styleClass="mini-stat-value mini-stat-purple" text="\$0" />
            </VBox>
        </HBox>

        <!-- ── Gráfica: Ingresos del Mes ── -->
        <VBox styleClass="card" spacing="0" style="-fx-padding: 14 20 10 20;">
            <HBox alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
                <Label text="Ingresos del Mes" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a2e3b;" />
                <Region HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="4">
                    <FontIcon fx:id="iconTendencia" iconLiteral="fas-arrow-up" iconSize="12" style="-fx-icon-color: #27ae60;" />
                    <Label fx:id="lblPorcentaje" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="" />
                    <Label text="vs mes anterior" style="-fx-font-size: 11px; -fx-text-fill: #6b7f8e;" />
                </HBox>
            </HBox>
            <!-- Barras: Regions con altura proporcional, alineadas al fondo -->
            <HBox fx:id="contenedorBarras" alignment="BOTTOM_LEFT" spacing="2"
                  prefHeight="80" minHeight="80" maxHeight="80" />
            <!-- Eje X: solo 3 etiquetas con justify-between -->
            <HBox style="-fx-padding: 4 0 0 0;">
                <Label fx:id="lblEje1" style="-fx-font-size: 10px; -fx-text-fill: #6b7f8e;" text="1 Jun" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblEje15" style="-fx-font-size: 10px; -fx-text-fill: #6b7f8e;" text="15 Jun" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblEjeFin" style="-fx-font-size: 10px; -fx-text-fill: #6b7f8e;" text="30 Jun" />
            </HBox>
        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar-row">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field-wrap">
                <FontIcon iconLiteral="fas-search" iconSize="14" styleClass="search-icon-fx" />
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefHeight="36" prefWidth="220" promptText="Buscar propietario o paciente..." />
            </HBox>
            <Button onAction="#handleBuscar" prefHeight="36" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Buscar" />
            <ComboBox fx:id="cbPropietario" prefHeight="36" prefWidth="180" promptText="Propietario" styleClass="filter-combo" />
            <ComboBox fx:id="cbEstadoPago" prefHeight="36" prefWidth="140" styleClass="filter-combo" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <StackPane styleClass="module-table-wrap" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaFacturas">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" minWidth="70" text="ID" />
                    <TableColumn fx:id="colPropietario" prefWidth="130" text="PROPIETARIO" />
                    <TableColumn fx:id="colPaciente" prefWidth="110" text="PACIENTE" />
                    <TableColumn fx:id="colFecha" prefWidth="100" text="FECHA" />
                    <TableColumn fx:id="colSubtotal" prefWidth="90" text="SUBTOTAL" />
                    <TableColumn fx:id="colImpuesto" prefWidth="80" text="IVA" />
                    <TableColumn fx:id="colTotal" prefWidth="90" text="TOTAL" />
                    <TableColumn fx:id="colEstado" prefWidth="115" text="ESTADO" />
                    <TableColumn fx:id="colMetodoPago" prefWidth="100" text="PAGO" />
                    <TableColumn fx:id="colAcciones" prefWidth="80" text="DETALLE" />
                    <TableColumn fx:id="colOperaciones" prefWidth="190" text="" />
                </columns>
            </TableView>
        </StackPane>

    </VBox>

</AnchorPane>