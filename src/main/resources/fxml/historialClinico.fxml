<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600" prefWidth="800" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="controlador.HistorialClinicoControlador">

    <VBox spacing="15" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

        <Label text="Historial Clínico del Paciente" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B6B2F;" />

        <HBox spacing="30" style="-fx-background-color: #F0F4F0; -fx-padding: 15; -fx-background-radius: 8;">
            <VBox spacing="5">
                <Label text="Nombre" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;" />
                <Label fx:id="lblNombre" text="---" style="-fx-text-fill: #1B6B2F; -fx-font-size: 14px; -fx-font-weight: bold;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Especie" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;" />
                <Label fx:id="lblEspecie" text="---" style="-fx-text-fill: #333333; -fx-font-size: 14px;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Raza" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;" />
                <Label fx:id="lblRaza" text="---" style="-fx-text-fill: #333333; -fx-font-size: 14px;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Propietario" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;" />
                <Label fx:id="lblPropietario" text="---" style="-fx-text-fill: #333333; -fx-font-size: 14px;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Microchip" style="-fx-font-weight: bold; -fx-text-fill: #555555; -fx-font-size: 11px;" />
                <Label fx:id="lblMicrochip" text="---" style="-fx-text-fill: #333333; -fx-font-size: 14px;" />
            </VBox>
        </HBox>

        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">

            <Tab text="Consultas" closable="false">
                <TableView fx:id="tablaConsultas" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colConFecha" text="Fecha" prefWidth="120" />
                        <TableColumn fx:id="colConSintomas" text="Síntomas" prefWidth="160" />
                        <TableColumn fx:id="colConDiagnostico" text="Diagnóstico" prefWidth="160" />
                        <TableColumn fx:id="colConTratamiento" text="Tratamiento" prefWidth="160" />
                        <TableColumn fx:id="colConVeterinario" text="Veterinario" prefWidth="130" />
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Vacunaciones" closable="false">
                <TableView fx:id="tablaVacunaciones" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colVacVacuna" text="Vacuna" prefWidth="140" />
                        <TableColumn fx:id="colVacFecha" text="Fecha Aplicación" prefWidth="130" />
                        <TableColumn fx:id="colVacProxima" text="Próxima Dosis" prefWidth="130" />
                        <TableColumn fx:id="colVacVeterinario" text="Veterinario" prefWidth="130" />
                        <TableColumn fx:id="colVacObservaciones" text="Observaciones" prefWidth="160" />
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Cirugías" closable="false">
                <TableView fx:id="tablaCirugias" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colCirTipo" text="Tipo" prefWidth="140" />
                        <TableColumn fx:id="colCirFecha" text="Fecha" prefWidth="120" />
                        <TableColumn fx:id="colCirAnestesia" text="Anestesia" prefWidth="100" />
                        <TableColumn fx:id="colCirResultado" text="Resultado" prefWidth="140" />
                        <TableColumn fx:id="colCirVeterinario" text="Veterinario" prefWidth="130" />
                        <TableColumn fx:id="colCirCosto" text="Costo" prefWidth="90" />
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Internaciones" closable="false">
                <TableView fx:id="tablaInternaciones" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colIntIngreso" text="Fecha Ingreso" prefWidth="120" />
                        <TableColumn fx:id="colIntEgreso" text="Fecha Egreso" prefWidth="120" />
                        <TableColumn fx:id="colIntEstado" text="Estado" prefWidth="100" />
                        <TableColumn fx:id="colIntVeterinario" text="Veterinario" prefWidth="130" />
                        <TableColumn fx:id="colIntCostoDia" text="Costo/Día" prefWidth="90" />
                        <TableColumn fx:id="colIntCostoTotal" text="Costo Total" prefWidth="100" />
                    </columns>
                </TableView>
            </Tab>

            <Tab text="Exámenes de Lab" closable="false">
                <TableView fx:id="tablaExamenes" style="-fx-background-color: white;">
                    <columns>
                        <TableColumn fx:id="colExaTipo" text="Tipo Examen" prefWidth="140" />
                        <TableColumn fx:id="colExaSolicitud" text="Fecha Solicitud" prefWidth="120" />
                        <TableColumn fx:id="colExaResultado" text="Fecha Resultado" prefWidth="120" />
                        <TableColumn fx:id="colExaResultados" text="Resultados" prefWidth="200" />
                        <TableColumn fx:id="colExaCosto" text="Costo" prefWidth="90" />
                    </columns>
                </TableView>
            </Tab>

        </TabPane>

    </VBox>

</AnchorPane>
