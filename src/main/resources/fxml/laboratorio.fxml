<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #F0F4F0;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="controlador.LaboratorioControlador">

    <VBox spacing="15" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

        <Label text="Exámenes de Laboratorio" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1B6B2F;" />

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" prefWidth="300" prefHeight="35" promptText="Buscar por paciente o tipo de examen" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
            <Button onAction="#handleBuscar" text="Buscar" prefHeight="35" style="-fx-background-color: #1B6B2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>

        <TableView fx:id="tablaExamenes" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colPaciente" text="Paciente" prefWidth="120" />
                <TableColumn fx:id="colTipoExamen" text="Tipo Examen" prefWidth="140" />
                <TableColumn fx:id="colFechaSolicitud" text="Fecha Solicitud" prefWidth="120" />
                <TableColumn fx:id="colFechaResultado" text="Fecha Resultado" prefWidth="120" />
                <TableColumn fx:id="colResultados" text="Resultados" prefWidth="180" />
                <TableColumn fx:id="colCosto" text="Costo" prefWidth="90" />
            </columns>
        </TableView>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button onAction="#handleNuevo" text="Nuevo Examen" prefHeight="38" prefWidth="160" style="-fx-background-color: #1B6B2F; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button onAction="#handleRegistrarResultado" text="Registrar Resultado" prefHeight="38" prefWidth="170" style="-fx-background-color: white; -fx-text-fill: #1B6B2F; -fx-font-size: 13px; -fx-border-color: #1B6B2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button onAction="#handleVerDetalle" text="Ver Detalle" prefHeight="38" prefWidth="140" style="-fx-background-color: white; -fx-text-fill: #1B6B2F; -fx-font-size: 13px; -fx-border-color: #1B6B2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>

    </VBox>

</AnchorPane>
