<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane styleClass="module-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MedicamentosController">

    <VBox spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="module-page-header">
            <Label style="-fx-font-size: 13px;" styleClass="module-page-subtitle" text="Inventario de medicamentos de la clínica" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleNuevo" prefHeight="40" minHeight="40" maxHeight="40" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary btn-add" text="+  Nuevo Medicamento" />
        </HBox>

        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Total Medicamentos" />
                <Label fx:id="lblStatTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b87a0;" styleClass="mini-stat-value mini-stat-teal" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Disponibles" />
                <Label fx:id="lblStatDisponibles" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" styleClass="mini-stat-value mini-stat-green" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Agotados" />
                <Label fx:id="lblStatAgotados" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e53e3e;" styleClass="mini-stat-value mini-stat-red" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Por Vencer" />
                <Label fx:id="lblStatPorVencer" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" styleClass="mini-stat-value mini-stat-orange" text="0" />
            </VBox>
        </HBox>

        <HBox fx:id="bannerStockBajo" alignment="CENTER_LEFT" managed="false" spacing="10" visible="false" style="-fx-background-color: #fffbeb; -fx-border-color: #f59e0b; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16 10 16;">
            <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="14" style="-fx-icon-color: #d97706;" />
            <Label fx:id="lblBannerStockBajo" style="-fx-font-size: 13px; -fx-text-fill: #92400e; -fx-font-weight: bold;" text="" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar-row">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field-wrap">
                <FontIcon iconLiteral="fas-search" iconSize="14" styleClass="search-icon-fx" />
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefHeight="36" prefWidth="280" promptText="Buscar nombre o principio activo..." />
            </HBox>
            <Button onAction="#handleBuscar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Buscar" />
            <ComboBox fx:id="cbEstado" prefHeight="36" prefWidth="150" styleClass="filter-combo" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEditar" disable="true" onAction="#handleEditar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: #ece8fd; -fx-text-fill: #7c3aed; -fx-border-color: #7c3aed; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" text="Modificar" />
            <Button fx:id="btnStock" disable="true" onAction="#handleStock" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: #e8f5e9; -fx-text-fill: #27ae60; -fx-border-color: #27ae60; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" text="+ Reabastecer" />
        </HBox>

        <StackPane styleClass="module-table-wrap" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaMedicamentos">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" minWidth="70" text="ID" />
                    <TableColumn fx:id="colNombre" prefWidth="140" text="NOMBRE" />
                    <TableColumn fx:id="colCategoria" prefWidth="130" text="CATEGORÍA" />
                    <TableColumn fx:id="colConcentracion" prefWidth="100" text="CONCENTRACIÓN" />
                    <TableColumn fx:id="colPrecio" prefWidth="90" text="PRECIO" />
                    <TableColumn fx:id="colVencimiento" prefWidth="100" text="VENCIMIENTO" />
                    <TableColumn fx:id="colStock" prefWidth="145" minWidth="130" text="STOCK" />
                    <TableColumn fx:id="colEstado" prefWidth="115" text="ESTADO" />
                    <TableColumn fx:id="colAcciones" prefWidth="80" minWidth="60" text="DETALLE" />
                </columns>
            </TableView>
        </StackPane>

    </VBox>

</AnchorPane>