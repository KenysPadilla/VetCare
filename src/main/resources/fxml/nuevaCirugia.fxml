<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720" prefWidth="490" styleClass="form-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.NuevaCirugiaController">

    <VBox styleClass="form-shell" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="logo-blue-inline">
                <image><Image url="@../images/logo-blue.png" /></image>
            </ImageView>
            <Label text="Nueva Cirugía" styleClass="form-title" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="10" styleClass="form-body-scroll">

                <Label text="PARTICIPANTES" styleClass="form-section-header" />
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Paciente" styleClass="field-label" />
                    <ComboBox fx:id="cbPaciente" prefWidth="430" promptText="Seleccionar paciente" />
                </VBox>
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Cirujano / Veterinario" styleClass="field-label" />
                    <ComboBox fx:id="cbVeterinario" prefWidth="430" promptText="Seleccionar cirujano" />
                </VBox>

                <Separator style="-fx-opacity: 0.4;" />
                <Label text="PROCEDIMIENTO" styleClass="form-section-header" />
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Tipo de cirugía" styleClass="field-label" />
                    <TextField fx:id="txtTipo" prefHeight="40" promptText="Ej: Esterilización, Extracción dental" />
                </VBox>
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Fecha" styleClass="field-label" />
                        <DatePicker fx:id="dpFecha" prefWidth="205" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Anestesia" styleClass="field-label" />
                        <ComboBox fx:id="cbAnestesia" prefWidth="205" promptText="Seleccionar" />
                    </VBox>
                </HBox>
<VBox spacing="6" styleClass="field-group">
                    <Label text="Costo estimado" styleClass="field-label" />
                    <TextField fx:id="txtCosto" prefHeight="40" promptText="Ej: 250000" />
                </VBox>
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Descripción del procedimiento" styleClass="field-label" />
                    <TextArea fx:id="txtDescripcion" prefHeight="80"
                              promptText="Descripción del procedimiento" styleClass="text-area-input" />
                </VBox>

            </VBox>
        </ScrollPane>

        <VBox styleClass="form-footer">
            <Label fx:id="lblMensaje" text="" styleClass="form-message" />
            <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="form-actions">
                <Button onAction="#handleGuardar" text="Guardar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cerrar" />
                <Button onAction="#handleCancelar" text="Cancelar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cancelar" />
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>