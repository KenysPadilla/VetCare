<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720" prefWidth="500" styleClass="form-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.NuevaCitaController">

    <VBox styleClass="form-shell" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="logo-blue-inline">
                <image><Image url="@../images/logo-blue.png" /></image>
            </ImageView>
            <Label text="Nueva Cita Médica" styleClass="form-title" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="12" styleClass="form-body-scroll">

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Paciente" styleClass="field-label" />
                    <ComboBox fx:id="cbPaciente" prefWidth="440" promptText="Seleccionar paciente" />
                </VBox>

                <HBox spacing="15">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Especie" styleClass="field-label" style="-fx-font-size: 11px;" />
                        <Label fx:id="lblEspecie" text="—" style="-fx-text-fill: #2b87a0; -fx-font-weight: bold; -fx-padding: 4 8;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Raza" styleClass="field-label" style="-fx-font-size: 11px;" />
                        <Label fx:id="lblRaza" text="—" style="-fx-text-fill: #6b7f8e; -fx-padding: 4 8;" />
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Sexo" styleClass="field-label" style="-fx-font-size: 11px;" />
                        <Label fx:id="lblSexo" text="—" style="-fx-text-fill: #6b7f8e; -fx-padding: 4 8;" />
                    </VBox>
                </HBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Veterinario" styleClass="field-label" />
                    <ComboBox fx:id="cbVeterinario" prefWidth="440" promptText="Seleccionar veterinario" />
                </VBox>

                <HBox spacing="15">
                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Fecha" styleClass="field-label" />
                        <DatePicker fx:id="dpFecha" prefWidth="210" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group">
                        <Label text="Hora" styleClass="field-label" />
                        <ComboBox fx:id="cbHora" prefWidth="210" promptText="Seleccionar hora" />
                    </VBox>
                </HBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Tipo de Cita" styleClass="field-label" />
                    <ComboBox fx:id="cbTipo" prefWidth="440" promptText="Seleccionar tipo" />
                </VBox>

                <VBox spacing="6" styleClass="field-group">
                    <Label text="Motivo" styleClass="field-label" />
                    <TextArea fx:id="txtMotivo" prefHeight="80" promptText="Describa el motivo de la cita" styleClass="text-area-input" />
                </VBox>

            </VBox>
        </ScrollPane>

        <VBox styleClass="form-footer">
            <Label fx:id="lblMensaje" text="" styleClass="form-message" />
            <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="form-actions">
                <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cerrar" />
                <Button fx:id="btnCancelar" onAction="#handleCancelar" text="Cancelar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cancelar" />
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>