<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="480" prefWidth="450" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="controller.NuevoMedicamentoController">

    <VBox spacing="12" AnchorPane.topAnchor="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="30" AnchorPane.rightAnchor="30">

        <Label text="Nuevo Medicamento" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B6B2F;" />

        <VBox spacing="5">
            <Label text="Nombre comercial" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <TextField fx:id="txtNombre" prefHeight="35" promptText="Nombre del medicamento" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
        </VBox>

        <VBox spacing="5">
            <Label text="Principio activo" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <TextField fx:id="txtPrincipio" prefHeight="35" promptText="Sustancia activa" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
        </VBox>

        <VBox spacing="5">
            <Label text="Presentación" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <ComboBox fx:id="cbPresentacion" prefWidth="390" promptText="Seleccionar" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6;" />
        </VBox>

        <VBox spacing="5">
            <Label text="Dosis estándar" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
            <TextField fx:id="txtDosis" prefHeight="35" promptText="Ej: 1 tableta cada 12 horas" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
        </VBox>

        <HBox spacing="15">
            <VBox spacing="5">
                <Label text="Stock" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                <TextField fx:id="txtStock" prefHeight="35" prefWidth="120" promptText="Cantidad" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Precio unitario" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                <TextField fx:id="txtPrecio" prefHeight="35" prefWidth="120" promptText="Ej: 15000" style="-fx-border-color: #D6EAD8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6;" />
            </VBox>
            <VBox spacing="5">
                <Label text="Vencimiento" style="-fx-font-weight: bold; -fx-text-fill: #333333;" />
                <DatePicker fx:id="dpVencimiento" prefWidth="140" />
            </VBox>
        </HBox>

        <Label fx:id="lblMensaje" text="" style="-fx-font-size: 12px;" />

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button onAction="#handleGuardar" text="Guardar" prefHeight="40" prefWidth="140" style="-fx-background-color: #1B6B2F; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
            <Button onAction="#handleCancelar" text="Cancelar" prefHeight="40" prefWidth="140" style="-fx-background-color: white; -fx-text-fill: #D32F2F; -fx-font-size: 13px; -fx-border-color: #D32F2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
        </HBox>

    </VBox>

</AnchorPane>
