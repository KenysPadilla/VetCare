<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="720" prefWidth="460" styleClass="form-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.NuevoPacienteController">

    <VBox styleClass="form-shell" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="logo-blue-inline">
                <image><Image url="@../images/logo-blue.png" /></image>
            </ImageView>
            <Label fx:id="lblTitulo" text="Nuevo Paciente" styleClass="form-title" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="10" styleClass="form-body-scroll">

                <Label text="PROPIETARIO" styleClass="form-section-header" />
                <CheckBox fx:id="chkSinPropietario" onAction="#handleTogglePropietario"
                          text="Sin propietario"
                          style="-fx-font-size: 12px; -fx-text-fill: #5a7585; -fx-cursor: hand;" />

                <VBox fx:id="vboxConPropietario" spacing="6" styleClass="field-group">
                    <Label text="Propietario existente" styleClass="field-label" />
                    <ComboBox fx:id="cbPropietario" prefWidth="400" promptText="Seleccionar propietario..." />
                    <HBox alignment="CENTER" maxWidth="Infinity"
                          onMouseClicked="#handleToggleNuevoPropietario"
                          style="-fx-border-color: #a8d4f0; -fx-border-style: dashed; -fx-border-radius: 6; -fx-background-color: #f0f8ff; -fx-background-radius: 6; -fx-padding: 12; -fx-cursor: hand;">
                        <Label fx:id="lblToggleProp" text="＋  Registrar nuevo propietario"
                               style="-fx-text-fill: #1a7abf; -fx-font-size: 13px; -fx-font-weight: bold; -fx-cursor: hand;" />
                    </HBox>

                    <VBox fx:id="panelNuevoProp" spacing="8" visible="false" managed="false">
                        <Separator style="-fx-opacity: 0.4;" />
                        <Label text="DATOS DEL NUEVO PROPIETARIO" styleClass="form-section-header" />
                        <VBox spacing="4">
                            <Label text="Cédula *" styleClass="field-label" />
                            <TextField fx:id="txtNuevaCedula" prefHeight="36" promptText="Número de cédula" />
                        </VBox>
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Nombre *" styleClass="field-label" />
                                <TextField fx:id="txtNuevoNombre" prefHeight="36" promptText="Nombre(s)" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Apellido *" styleClass="field-label" />
                                <TextField fx:id="txtNuevoApellido" prefHeight="36" promptText="Apellido(s)" />
                            </VBox>
                        </HBox>
                        <HBox spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Teléfono" styleClass="field-label" />
                                <TextField fx:id="txtNuevoTelefono" prefHeight="36" promptText="Número de contacto" />
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Correo" styleClass="field-label" />
                                <TextField fx:id="txtNuevoCorreo" prefHeight="36" promptText="correo@ejemplo.com" />
                            </VBox>
                        </HBox>
                        <VBox spacing="4">
                            <Label text="Dirección" styleClass="field-label" />
                            <TextField fx:id="txtNuevaDireccion" prefHeight="36" promptText="Dirección de residencia" />
                        </VBox>
                    </VBox>
                </VBox>

                <Separator style="-fx-opacity: 0.4;" />
                <Label text="DATOS DEL ANIMAL" styleClass="form-section-header" />
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Nombre" styleClass="field-label" />
                    <TextField fx:id="txtNombre" prefHeight="40" promptText="Nombre de la mascota" />
                </VBox>
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Especie" styleClass="field-label" />
                        <ComboBox fx:id="cbEspecie" prefWidth="190" promptText="Seleccionar" />
                        <TextField fx:id="txtEspecieOtro" prefHeight="40" prefWidth="190"
                                   promptText="Especifica la especie..."
                                   visible="false" managed="false" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Raza" styleClass="field-label" />
                        <ComboBox fx:id="cbRaza" prefWidth="190" prefHeight="40"
                                  promptText="Buscar raza..." editable="true" />
                        <TextField fx:id="txtRazaOtra" prefHeight="40" prefWidth="190"
                                   promptText="Especifica la raza..."
                                   visible="false" managed="false" />
                    </VBox>
                </HBox>
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Sexo" styleClass="field-label" />
                        <ComboBox fx:id="cbSexo" prefWidth="190" promptText="Seleccionar" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Peso (kg)" styleClass="field-label" />
                        <TextField fx:id="txtPeso" prefHeight="40" prefWidth="190" promptText="Ej: 12.5" />
                    </VBox>
                </HBox>

                <Separator style="-fx-opacity: 0.4;" />
                <Label text="IDENTIFICACIÓN" styleClass="form-section-header" />
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Fecha de nacimiento" styleClass="field-label" />
                        <DatePicker fx:id="dpFechaNacimiento" prefWidth="190" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Microchip" styleClass="field-label" />
                        <TextField fx:id="txtMicrochip" prefHeight="40" prefWidth="190" promptText="Código microchip" />
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>

        <Label fx:id="lblMensaje" text="" styleClass="form-message form-message-row" />

        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="detail-footer">
            <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar"
                    prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cerrar" />
            <Button onAction="#handleCancelar" text="Cancelar"
                    prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cancelar" />
        </HBox>

    </VBox>
</AnchorPane>
