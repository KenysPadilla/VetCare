<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.ScrollPane?>

<AnchorPane prefHeight="720" prefWidth="460" styleClass="form-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.NuevoPacienteController">

    <VBox styleClass="form-shell" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="form-header">
            <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="logo-blue-inline">
                <image><Image url="@../images/logo-blue.png" /></image>
            </ImageView>
            <Label fx:id="lblTitulo" text="Nuevo Paciente" styleClass="form-title" />
        </HBox>

        <ScrollPane fitToWidth="true" styleClass="form-scroll" VBox.vgrow="ALWAYS">
            <VBox spacing="10" styleClass="form-body-scroll">

                <Label text="PROPIETARIO" styleClass="form-section-header" />
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Propietario (opcional)" styleClass="field-label" />
                    <ComboBox fx:id="cbPropietario" prefWidth="400" promptText="Sin propietario (opcional)" />
                </VBox>

                <Separator style="-fx-opacity: 0.4;" />
                <Label text="DATOS DEL ANIMAL" styleClass="form-section-header" />
                <VBox spacing="6" styleClass="field-group">
                    <Label text="Nombre" styleClass="field-label" />
                    <TextField fx:id="txtNombre" prefHeight="40" promptText="Nombre de la mascota" />
                </VBox>
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Especie" styleClass="field-label" />
                        <ComboBox fx:id="cbEspecie" prefWidth="190" promptText="Seleccionar" />
                        <TextField fx:id="txtEspecieOtro" prefHeight="40" prefWidth="190"
                                   promptText="Especifica la especie..."
                                   visible="false" managed="false" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Raza" styleClass="field-label" />
                        <TextField fx:id="txtRaza" prefHeight="40" prefWidth="190" promptText="Raza" />
                    </VBox>
                </HBox>
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Sexo" styleClass="field-label" />
                        <ComboBox fx:id="cbSexo" prefWidth="190" promptText="Seleccionar" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Peso (kg)" styleClass="field-label" />
                        <TextField fx:id="txtPeso" prefHeight="40" prefWidth="190" promptText="Ej: 12.5" />
                    </VBox>
                </HBox>

                <Separator style="-fx-opacity: 0.4;" />
                <Label text="IDENTIFICACIÓN" styleClass="form-section-header" />
                <HBox spacing="14">
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Fecha de nacimiento" styleClass="field-label" />
                        <DatePicker fx:id="dpFechaNacimiento" prefWidth="190" />
                    </VBox>
                    <VBox spacing="6" styleClass="field-group" HBox.hgrow="ALWAYS">
                        <Label text="Microchip" styleClass="field-label" />
                        <TextField fx:id="txtMicrochip" prefHeight="40" prefWidth="190" promptText="Código microchip" />
                    </VBox>
                </HBox>
        </VBox>
        </ScrollPane>

        <VBox styleClass="form-footer">
            <Label fx:id="lblMensaje" text="" styleClass="form-message" />
            <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="form-actions">
                <Button fx:id="btnGuardar" onAction="#handleGuardar" text="Guardar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cerrar" />
                <Button onAction="#handleCancelar" text="Cancelar"
                        prefHeight="28" minHeight="28" maxHeight="28" prefWidth="140" styleClass="btn-cancelar" />
            </HBox>
        </VBox>

    </VBox>
</AnchorPane>