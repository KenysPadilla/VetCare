<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane styleClass="module-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PacientesController">

    <VBox spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <Label fx:id="lblFiltro" managed="false" styleClass="filter-banner" text="" visible="false" />

        <HBox alignment="CENTER_LEFT" styleClass="module-page-header">
            <Label style="-fx-font-size: 13px;" styleClass="module-page-subtitle" text="Historial y gestión de pacientes registrados" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnVerTodos" managed="false" onAction="#handleVerTodos" prefHeight="40" minHeight="40" maxHeight="40" prefWidth="160" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Ver todos" visible="false" />
            <Button fx:id="btnNuevo" onAction="#handleNuevo" prefHeight="40" minHeight="40" maxHeight="40" prefWidth="160" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary btn-add" text="+  Nuevo Paciente" />
        </HBox>

        <GridPane hgap="16" styleClass="mini-stats-row" vgap="16">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
            </columnConstraints>
            <VBox styleClass="mini-stat-card" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Total Pacientes" />
                <Label fx:id="lblStatTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b87a0;" styleClass="mini-stat-value mini-stat-teal" text="0" />
            </VBox>
            <VBox styleClass="mini-stat-card" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Perros" />
                <Label fx:id="lblStatPerros" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e67e22;" styleClass="mini-stat-value mini-stat-orange" text="0" />
            </VBox>
            <VBox styleClass="mini-stat-card" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Gatos" />
                <Label fx:id="lblStatGatos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;" styleClass="mini-stat-value mini-stat-purple" text="0" />
            </VBox>
            <VBox styleClass="mini-stat-card" GridPane.columnIndex="3" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Sin Propietario" />
                <Label fx:id="lblStatSinPropietario" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6b7f8e;" styleClass="mini-stat-value mini-stat-muted" text="0" />
            </VBox>
        </GridPane>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar-row">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field-wrap">
                <FontIcon iconLiteral="fas-search" iconSize="14" styleClass="search-icon-fx" />
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefHeight="36" prefWidth="240" promptText="Buscar paciente..." />
            </HBox>
            <Button onAction="#handleBuscar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Buscar" />
            <ComboBox fx:id="cbEspecie" prefHeight="36" prefWidth="150" promptText="Todas las especies" styleClass="filter-combo" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEditar" disable="true" onAction="#handleEditar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: #ece8fd; -fx-text-fill: #7c3aed; -fx-border-color: #7c3aed; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" text="Modificar" />
        </HBox>

        <StackPane styleClass="module-table-wrap" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaPacientes">
                <columns>
                    <TableColumn fx:id="colPaciente" prefWidth="140" text="PACIENTE" />
                    <TableColumn fx:id="colEspecieRaza" prefWidth="130" text="ESPECIE / RAZA" />
                    <TableColumn fx:id="colSexo" prefWidth="70" minWidth="60" text="SEXO" />
                    <TableColumn fx:id="colEdadPeso" prefWidth="100" text="EDAD / PESO" />
                    <TableColumn fx:id="colPropietario" prefWidth="130" text="PROPIETARIO" />
                    <TableColumn fx:id="colVeterinario" prefWidth="110" text="VETERINARIO" />
                    <TableColumn fx:id="colUltimaVisita" prefWidth="100" text="ÚLTIMA VISITA" />
                    <TableColumn fx:id="colAcciones" prefWidth="135" minWidth="120" text="HISTORIA CLÍNICA" />
                </columns>
            </TableView>
        </StackPane>

    </VBox>

</AnchorPane>