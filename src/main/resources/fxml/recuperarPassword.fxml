<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox prefHeight="600" prefWidth="960" styleClass="login-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RecuperarPasswordController">

    <!-- Panel izquierdo: marca — idéntico al login principal -->
    <VBox minWidth="480" maxWidth="480" alignment="CENTER" spacing="20" styleClass="login-brand-panel">
        <ImageView fitHeight="160" fitWidth="160" pickOnBounds="true" preserveRatio="true" smooth="true" styleClass="login-logo">
            <image>
                <Image url="@../images/logo-white.png" />
            </image>
        </ImageView>
        <Label style="-fx-font-size: 40px; -fx-font-weight: bold;" styleClass="login-brand-title" text="VetCare" />
        <Label fx:id="lblDescripcionIzquierda" styleClass="login-brand-subtitle"
               text="Gestión Integral de Clínica Veterinaria" />
    </VBox>

    <!-- Panel derecho: pasos del flujo — ocupa los 480 px restantes -->
    <VBox HBox.hgrow="ALWAYS" minWidth="480" alignment="CENTER" styleClass="login-form-panel">
        <Region VBox.vgrow="ALWAYS" />

        <!-- Paso 1: Solicitud -->
        <VBox fx:id="panelSolicitud" alignment="CENTER" spacing="18" styleClass="login-card">

            <!-- Indicador de pasos: 1(activo) ── 2(pendiente) ── 3(pendiente) -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="step-circle-active" text="1" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line" />
                <Label styleClass="step-circle-pending" text="2" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line" />
                <Label styleClass="step-circle-pending" text="3" />
            </HBox>

            <VBox spacing="4">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="login-card-title" text="Recuperar Contraseña" />
                <Label styleClass="login-card-subtitle" text="Ingresa tu usuario y correo electrónico" />
            </VBox>

            <VBox spacing="6" styleClass="field-group">
                <Label styleClass="field-label" text="Usuario" />
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-with-icon">
                    <FontIcon iconLiteral="fas-user" iconSize="14" styleClass="input-icon-fx" />
                    <TextField fx:id="txtUsuario" HBox.hgrow="ALWAYS" promptText="Ingresa tu usuario" />
                </HBox>
            </VBox>

            <VBox spacing="6" styleClass="field-group">
                <Label styleClass="field-label" text="Correo Electrónico" />
                <HBox alignment="CENTER_LEFT" spacing="8" styleClass="input-with-icon">
                    <FontIcon iconLiteral="fas-envelope" iconSize="14" styleClass="input-icon-fx" />
                    <TextField fx:id="txtCorreo" HBox.hgrow="ALWAYS" promptText="ejemplo@correo.com" />
                </HBox>
            </VBox>

            <VBox spacing="10">
                <Button fx:id="btnEnviar" maxWidth="Infinity" onAction="#handleEnviar" prefHeight="46" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary" text="Enviar Código" />
                <Button fx:id="btnVolver" maxWidth="Infinity" onAction="#handleVolver" prefHeight="42" style="-fx-background-color: #e8f4f8; -fx-text-fill: #2b87a0; -fx-border-color: #2b87a0; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-secondary" text="← Volver al Login" />
                <Label fx:id="lblMensaje" managed="false" styleClass="label-error" text="" visible="false" />
            </VBox>
        </VBox>

        <!-- Paso 2: Verificación -->
        <VBox fx:id="panelCodigo" alignment="CENTER" managed="false" spacing="18" styleClass="login-card" visible="false">

            <!-- Indicador de pasos: ✓(hecho) ── 2(activo) ── 3(pendiente) -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="step-circle-check" text="✓" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line-done" />
                <Label styleClass="step-circle-active" text="2" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line" />
                <Label styleClass="step-circle-pending" text="3" />
            </HBox>

            <!-- Volver -->
            <Button maxWidth="Infinity" onAction="#handleVolver" styleClass="btn-back-link" text="← Volver" />

            <!-- Título y subtítulo -->
            <VBox spacing="6">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="login-card-title" text="Verificar Código" />
                <Label styleClass="login-card-subtitle" wrapText="true"
                       text="Ingrese el código de 6 dígitos que fue enviado a su correo electrónico." />
            </VBox>

            <!-- 6 cajas de dígito -->
            <VBox spacing="10">
                <Label styleClass="field-label" text="Código de Verificación" />
                <HBox alignment="CENTER" spacing="8">
                    <TextField fx:id="txtD1" styleClass="digit-box" />
                    <TextField fx:id="txtD2" styleClass="digit-box" />
                    <TextField fx:id="txtD3" styleClass="digit-box" />
                    <TextField fx:id="txtD4" styleClass="digit-box" />
                    <TextField fx:id="txtD5" styleClass="digit-box" />
                    <TextField fx:id="txtD6" styleClass="digit-box" />
                </HBox>
            </VBox>

            <!-- Reenviar -->
            <HBox alignment="CENTER">
                <Hyperlink fx:id="lnkReenviar" onAction="#handleReenviar" text="¿No recibiste el código? Reenviar" />
            </HBox>

            <!-- Verificar -->
            <Button fx:id="btnVerificar" maxWidth="Infinity" onAction="#handleVerificar" prefHeight="46"
                    style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;"
                    styleClass="btn-primary" text="Verificar Código" />

            <Label fx:id="lblMensajeCodigo" managed="false" styleClass="label-error" text="" visible="false" />
        </VBox>

        <!-- Paso 3: Nueva contraseña -->
        <VBox fx:id="panelNuevaPassword" alignment="CENTER" managed="false" spacing="18" styleClass="login-card" visible="false">

            <!-- Indicador de pasos: ✓(hecho) ── ✓(hecho) ── 3(activo) -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label styleClass="step-circle-check" text="✓" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line-done" />
                <Label styleClass="step-circle-check" text="✓" />
                <Region HBox.hgrow="ALWAYS" styleClass="step-line-done" />
                <Label styleClass="step-circle-active" text="3" />
            </HBox>

            <!-- Volver -->
            <Button maxWidth="Infinity" onAction="#handleVolver" styleClass="btn-back-link" text="← Volver" />

            <!-- Título y subtítulo -->
            <VBox spacing="6">
                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" styleClass="login-card-title" text="Nueva Contraseña" />
                <Label styleClass="login-card-subtitle" text="Cree una contraseña segura para su cuenta." />
            </VBox>

            <!-- Nueva Contraseña con toggle ojo -->
            <VBox spacing="6" styleClass="field-group">
                <Label styleClass="field-label" text="Nueva Contraseña" />
                <HBox fx:id="boxNueva" alignment="CENTER_LEFT" spacing="4" styleClass="input-with-icon">
                    <FontIcon iconLiteral="fas-lock" iconSize="14" styleClass="input-icon-fx" />
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="txtNuevaPassword" promptText="Mínimo 8 caracteres" />
                        <TextField fx:id="txtNuevaVisible" promptText="Mínimo 8 caracteres" managed="false" visible="false" />
                    </StackPane>
                    <Button fx:id="btnToggleNueva" onAction="#handleToggleNueva" styleClass="btn-icon" />
                </HBox>
            </VBox>

            <!-- Confirmar Contraseña con toggle ojo -->
            <VBox spacing="6" styleClass="field-group">
                <Label styleClass="field-label" text="Confirmar Contraseña" />
                <HBox fx:id="boxConfirmar" alignment="CENTER_LEFT" spacing="4" styleClass="input-with-icon">
                    <FontIcon iconLiteral="fas-lock" iconSize="14" styleClass="input-icon-fx" />
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="txtConfirmarPassword" promptText="Repita la contraseña" />
                        <TextField fx:id="txtConfirmarVisible" promptText="Repita la contraseña" managed="false" visible="false" />
                    </StackPane>
                    <Button fx:id="btnToggleConfirmar" onAction="#handleToggleConfirmar" styleClass="btn-icon" />
                </HBox>
            </VBox>

            <!-- Cambiar contraseña -->
            <Button fx:id="btnCambiar" maxWidth="Infinity" onAction="#handleCambiar" prefHeight="46"
                    style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;"
                    styleClass="btn-primary" text="Cambiar Contraseña" />

            <Label fx:id="lblMensajePassword" managed="false" styleClass="label-error" text="" visible="false" />
        </VBox>

        <Region VBox.vgrow="ALWAYS" />
    </VBox>

</HBox>