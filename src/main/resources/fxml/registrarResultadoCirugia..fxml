<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="480" prefHeight="410" styleClass="detail-dialog"
            xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
            fx:controller="controller.RegistrarResultadoCirugiaController">

    <VBox AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
          AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

        <VBox styleClass="detail-header" spacing="4">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="detail-header-brand">
                <HBox alignment="CENTER" styleClass="detail-header-logo-box">
                    <ImageView fitHeight="28" fitWidth="28" preserveRatio="true" styleClass="detail-header-logo">
                        <image><Image url="@../images/logo-white.png" /></image>
                    </ImageView>
                </HBox>
                <VBox spacing="3">
                    <Label text="Registrar Resultado" styleClass="detail-header-title" />
                    <Label fx:id="lblHeaderCirugia" styleClass="detail-header-subtitle" />
                </VBox>
            </HBox>
        </VBox>

        <VBox styleClass="detail-content" spacing="18" VBox.vgrow="ALWAYS">

            <Label text="RESULTADO DE LA CIRUGÍA" styleClass="detail-section-title" />

            <HBox spacing="16" alignment="CENTER">
                <ToggleButton fx:id="btnExitosa" prefWidth="196" prefHeight="76" />
                <ToggleButton fx:id="btnComplicacion" prefWidth="196" prefHeight="76" />
            </HBox>

            <Label text="OBSERVACIONES (opcional)" styleClass="detail-section-title" />
            <VBox styleClass="lab-obs-panel">
                <TextArea fx:id="taObservaciones" prefHeight="95" wrapText="true"
                          promptText="Describa detalles del resultado, complicaciones o seguimiento recomendado..."
                          style="-fx-font-size: 12px;" />
            </VBox>

        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="10" styleClass="detail-footer">
            <Button text="Cancelar" onAction="#handleCancelar"
                    prefHeight="28" minHeight="28" maxHeight="28" prefWidth="100" styleClass="btn-cancelar" />
            <Button text="Guardar" onAction="#handleGuardar"
                    prefHeight="28" minHeight="28" maxHeight="28" prefWidth="100" styleClass="btn-cerrar" />
        </HBox>

    </VBox>
</AnchorPane>
