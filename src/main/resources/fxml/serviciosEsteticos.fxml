<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane style="-fx-background-color: #F0F4F0;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21" fx:controller="controlador.ServiciosEsteticosControlador">

    <VBox spacing="15" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

        <Label text="Servicios de Baño y Motilada" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1B6B2F;" />

        <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS">

            <Tab text="Baño" closable="false">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tablaBanos" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colBanoId" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colBanoPaciente" text="Paciente" prefWidth="120" />
                            <TableColumn fx:id="colBanoEstilista" text="Estilista" prefWidth="120" />
                            <TableColumn fx:id="colBanoFecha" text="Fecha/Hora" prefWidth="140" />
                            <TableColumn fx:id="colBanoTipo" text="Tipo Baño" prefWidth="120" />
                            <TableColumn fx:id="colBanoEstado" text="Estado" prefWidth="100" />
                            <TableColumn fx:id="colBanoCosto" text="Costo" prefWidth="90" />
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button onAction="#handleNuevoBano" text="Nuevo Baño" prefHeight="38" prefWidth="150" style="-fx-background-color: #1B6B2F; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button onAction="#handleCancelarBano" text="Cancelar" prefHeight="38" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #D32F2F; -fx-font-size: 13px; -fx-border-color: #D32F2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button onAction="#handleCompletarBano" text="Completar" prefHeight="38" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #1B6B2F; -fx-font-size: 13px; -fx-border-color: #1B6B2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </Tab>

            <Tab text="Motilada" closable="false">
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tablaMotiladas" VBox.vgrow="ALWAYS" style="-fx-background-color: white;">
                        <columns>
                            <TableColumn fx:id="colMotiladaId" text="ID" prefWidth="50" />
                            <TableColumn fx:id="colMotiladaPaciente" text="Paciente" prefWidth="120" />
                            <TableColumn fx:id="colMotiladaEstilista" text="Estilista" prefWidth="120" />
                            <TableColumn fx:id="colMotiladaFecha" text="Fecha/Hora" prefWidth="140" />
                            <TableColumn fx:id="colMotiladaEstilo" text="Estilo" prefWidth="120" />
                            <TableColumn fx:id="colMotiladaEstado" text="Estado" prefWidth="100" />
                            <TableColumn fx:id="colMotiladaCosto" text="Costo" prefWidth="90" />
                        </columns>
                    </TableView>
                    <HBox spacing="10">
                        <Button onAction="#handleNuevaMotilada" text="Nueva Motilada" prefHeight="38" prefWidth="160" style="-fx-background-color: #1B6B2F; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button onAction="#handleCancelarMotilada" text="Cancelar" prefHeight="38" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #D32F2F; -fx-font-size: 13px; -fx-border-color: #D32F2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button onAction="#handleCompletarMotilada" text="Completar" prefHeight="38" prefWidth="120" style="-fx-background-color: white; -fx-text-fill: #1B6B2F; -fx-font-size: 13px; -fx-border-color: #1B6B2F; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" />
                    </HBox>
                </VBox>
            </Tab>

        </TabPane>

    </VBox>

</AnchorPane>
