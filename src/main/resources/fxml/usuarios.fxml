<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane styleClass="module-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UsuariosController">

    <VBox spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="module-page-header">
            <Label style="-fx-font-size: 13px;" styleClass="module-page-subtitle" text="Usuarios del sistema y control de acceso" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleNuevo" prefHeight="40" minHeight="40" maxHeight="40" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary btn-add" text="+  Nuevo Usuario" />
        </HBox>

        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Total Usuarios" />
                <Label fx:id="lblStatTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b87a0;" styleClass="mini-stat-value mini-stat-teal" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Activos" />
                <Label fx:id="lblStatActivos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" styleClass="mini-stat-value mini-stat-green" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Inactivos" />
                <Label fx:id="lblStatInactivos" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6b7f8e;" styleClass="mini-stat-value mini-stat-muted" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Administradores" />
                <Label fx:id="lblStatAdmin" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8b5cf6;" styleClass="mini-stat-value mini-stat-purple" text="0" />
            </VBox>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar-row">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field-wrap">
                <FontIcon iconLiteral="fas-search" iconSize="14" styleClass="search-icon-fx" />
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefHeight="36" prefWidth="280" promptText="Buscar username o rol..." />
            </HBox>
            <Button onAction="#handleBuscar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Buscar" />
            <ComboBox fx:id="cbRol" prefHeight="36" prefWidth="160" styleClass="filter-combo" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnEditar" disable="true" onAction="#handleEditar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: #ece8fd; -fx-text-fill: #7c3aed; -fx-border-color: #7c3aed; -fx-border-radius: 8; -fx-border-width: 1.5; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" text="Modificar" />
        </HBox>

        <StackPane styleClass="module-table-wrap" VBox.vgrow="ALWAYS">
            <TableView fx:id="tablaUsuarios">
                <columns>
                    <TableColumn fx:id="colUsuario"  prefWidth="180" text="USUARIO" />
                    <TableColumn fx:id="colRol"      prefWidth="130" text="ROL" />
                    <TableColumn fx:id="colCorreo"   prefWidth="220" text="CORREO" />
                    <TableColumn fx:id="colEstado"   prefWidth="110" text="ESTADO" />
                    <TableColumn fx:id="colEmpleado" prefWidth="220" text="EMPLEADO VINCULADO" />
                </columns>
            </TableView>
        </StackPane>

    </VBox>

</AnchorPane>