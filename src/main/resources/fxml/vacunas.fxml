<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane styleClass="module-page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VacunasController">

    <VBox spacing="12" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

        <HBox alignment="CENTER_LEFT" styleClass="module-page-header">
            <Label style="-fx-font-size: 13px;" styleClass="module-page-subtitle" text="Catálogo de vacunas disponibles en inventario" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleNuevo" prefHeight="40" minHeight="40" maxHeight="40" style="-fx-background-color: #2b87a0; -fx-text-fill: white; -fx-border-color: transparent; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-primary btn-add" text="+  Nueva Vacuna" />
        </HBox>

        <HBox spacing="16">
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Total Vacunas" />
                <Label fx:id="lblStatTotal" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2b87a0;" styleClass="mini-stat-value mini-stat-teal" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Disponibles" />
                <Label fx:id="lblStatDisponibles" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" styleClass="mini-stat-value mini-stat-green" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Agotadas" />
                <Label fx:id="lblStatAgotadas" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #6b7f8e;" styleClass="mini-stat-value mini-stat-muted" text="0" />
            </VBox>
            <VBox HBox.hgrow="ALWAYS" styleClass="mini-stat-card">
                <Label style="-fx-font-size: 12px;" styleClass="mini-stat-label" text="Vencidas" />
                <Label fx:id="lblStatVencidas" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e53e3e;" styleClass="mini-stat-value mini-stat-red" text="0" />
            </VBox>
        </HBox>

        <!-- Banner stock crítico — oculto hasta que haya vacunas con stock bajo -->
        <HBox fx:id="bannerStockCritico" alignment="CENTER_LEFT" spacing="10"
              visible="false" managed="false"
              style="-fx-background-color: #fff0f0; -fx-background-radius: 10;
                     -fx-border-color: #e53e3e; -fx-border-radius: 10; -fx-border-width: 1.5;
                     -fx-padding: 10 16 10 16;">
            <FontIcon iconLiteral="fas-exclamation-triangle" iconSize="15" style="-fx-icon-color: #e53e3e;" />
            <Label fx:id="lblBannerNum" style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7f1d1d;" text="" />
            <Label text="con stock crítico. Contacte al proveedor inmediatamente." style="-fx-font-size: 13px; -fx-text-fill: #7f1d1d;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="module-toolbar-row">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-field-wrap">
                <FontIcon iconLiteral="fas-search" iconSize="14" styleClass="search-icon-fx" />
                <TextField fx:id="txtBuscar" onAction="#handleBuscar" prefHeight="36" prefWidth="280" promptText="Buscar nombre o laboratorio..." />
            </HBox>
            <Button onAction="#handleBuscar" prefHeight="36" minHeight="36" maxHeight="36" style="-fx-background-color: white; -fx-text-fill: #2b87a0; -fx-border-color: rgba(0,0,0,0.15); -fx-border-radius: 8; -fx-border-width: 1; -fx-background-insets: 0; -fx-font-size: 13px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 9 18 9 18; -fx-cursor: hand;" styleClass="btn-outline" text="Buscar" />
            <ComboBox fx:id="cbEstado" prefHeight="36" prefWidth="150" styleClass="filter-combo" />
            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <ScrollPane fx:id="scrollTarjetas" fitToWidth="true" styleClass="vacunas-scroll" VBox.vgrow="ALWAYS">
            <GridPane fx:id="gridTarjetas" style="-fx-padding: 4 0 16 0;" />
        </ScrollPane>

    </VBox>

</AnchorPane>